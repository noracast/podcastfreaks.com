# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt
.output

# Nuxt generate
dist

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# IDE
.idea

# PWA
sw.*

/static/downloads*
package-lock.json

# AI エージェント用のスキル（npx skills add でインストールするもの）
# 実体は Netlify のドキュメントのベンダリングで、リポジトリに入れると
# 本質と関係ないファイルで diff が膨らむため追跡しない。
# 必要な人は下記を1回実行すれば同じ状態になる:
#   npx skills add netlify/context-and-tools --skill '*' --yes
/.agents/
/skills-lock.json
# インストールしたスキル（.agents へのシンボリックリンク）は追跡しないが、
# このリポジトリで管理するスキルは追跡する
/.claude/skills/*
!/.claude/skills/feed-triage/
!/.claude/skills/add-channel/
