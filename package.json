{
  "name": "podcastfreaks.com",
  "version": "2.0.0",
  "description": "Podcast Freaks - Japanese techie podcast archive",
  "author": "Naokazu Terada",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "ncu": "pnpm dlx npm-check-updates",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "fetch-feeds": "node scripts/fetch-feeds.js",
    "icons": "node scripts/make-icons.js",
    "validate": "node scripts/validate.js",
    "added-at": "node scripts/update-added-at-cli.js",
    "apple-podcasts": "node scripts/update-apple-podcasts-cli.js",
    "health": "node scripts/check-site-health.js",
    "build": "pnpm fetch-feeds && nuxt generate",
    "build:skip": "nuxt generate",
    "deploy": "pnpm dlx netlify-cli deploy --dir=.output/public --prod",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit": "pnpm lint"
  },
  "config": {
    "nuxt": {
      "host": "0.0.0.0"
    }
  },
  "dependencies": {
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "nuxt": "^4.5.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "node-cleanup": "^2.1.2",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
