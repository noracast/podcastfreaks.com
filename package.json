{
  "name": "podcastfreaks.com",
  "version": "2.0.0",
  "description": "Podcast Freaks - Japanese techie podcast archive",
  "author": "Naokazu Terada",
  "private": true,
  "type": "module",
  "scripts": {
    "ncu": "npx npm-check-updates",
    "start": "nuxt",
    "prebuild": "node prebuild.js",
    "validate": "node scripts/validate.js",
    "added-at": "node scripts/update-added-at-cli.js",
    "apple-podcasts": "node scripts/update-apple-podcasts-cli.js",
    "health": "node scripts/check-site-health.js",
    "build": "nuxt generate",
    "build:skip": "nuxt generate",
    "deploy": "npx netlify-cli deploy --dir=dist --prod",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "precommit": "npm run lint"
  },
  "config": {
    "nuxt": {
      "host": "0.0.0.0"
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "consola": "^2.11.0",
    "file-saver": "^2.0.5",
    "moment": "^2.30.1",
    "nuxt": "^2.10.2",
    "opml-generator": "^1.1.1",
    "shelljs": "^0.8.5",
    "vue-clipboard2": "^0.3.1",
    "vue-highlightjs": "^1.3.3",
    "vue-tables-2": "^2.3.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nuxtjs/dotenv": "^1.4.2",
    "@nuxtjs/pwa": "^3.3.5",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "file-extension": "^4.0.5",
    "lodash": "^4.18.1",
    "node-cleanup": "^2.1.2",
    "sanitize-html": "^2.17.7",
    "serialize-error": "^5.0.0",
    "sharp": "^0.33.0",
    "vue-eslint-parser": "^10.4.1",
    "webpack": "^4.41.2"
  },
  "resolutions": {
    "vue": "2.7.16"
  }
}
